# ---- shared
CHAIN_ID=31611
RPC_URL=https://rpc.test.mezo.org
DATABASE_URL=postgres://user:pass@host:5432/lockwatch   # Railway Postgres; omit locally for embedded PGlite
LOCKWATCH_VAULT=                                        # set after deploying contracts/script/Deploy.s.sol
APP_URL=https://lockwatch.vercel.app

# ---- services (Railway)
KEEPER_PRIVATE_KEY=            # dedicated hot wallet with a little BTC for gas. Never commit.
TELEGRAM_BOT_TOKEN=            # @BotFather
TELEGRAM_MODE=polling          # or "webhook" (then set TELEGRAM_WEBHOOK_SECRET on Vercel too)
ADMIN_TELEGRAM_CHAT_ID=        # low-balance / dead-letter notices
RESEND_API_KEY=
EMAIL_FROM=Lockwatch <alerts@yourdomain>
TYPICAL_REDEMPTION_MUSD=10000

# ---- web (Vercel)
NEXT_PUBLIC_CHAIN_ID=31611
NEXT_PUBLIC_LOCKWATCH_VAULT=
NEXT_PUBLIC_TELEGRAM_BOT=LockwatchBot
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=     # WalletConnect cloud project id
SIWE_DOMAIN=lockwatch.vercel.app
TELEGRAM_WEBHOOK_SECRET=
